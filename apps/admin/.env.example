# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Admin auth
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha_segura
ADMIN_SESSION_SECRET=gerar_com_openssl_rand_hex_32

# Cross-app: aponta para apps/web em produção (ex: https://girob2b.com.br)
WEB_APP_URL=http://localhost:3000
# Deve ser o mesmo valor que ADMIN_API_SECRET em apps/web/.env.local
ADMIN_API_SECRET=gerar_com_openssl_rand_hex_32
